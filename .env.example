# ============================================================================
#  Plantilla de configuración. COPIA este archivo como  .env  y pon tus valores.
#  En Windows:   copy .env.example .env
#  En Mac/Linux: cp .env.example .env
#  El archivo .env NO se sube a GitHub (está en .gitignore).
# ============================================================================

# --- Datos del negocio (se muestran en todo el sitio) ---
NEGOCIO_NOMBRE="Angelica"
NEGOCIO_ESLOGAN="Transporte ejecutivo y VIP en Medellin"
NEGOCIO_CIUDAD="Medellin, Colombia"

# --- Contacto (footer + botón de WhatsApp) ---
CONTACTO_TELEFONO="+57 300 000 0000"
CONTACTO_EMAIL="reservas@example.com"
WHATSAPP_NUMERO="573000000000"
INSTAGRAM_URL="https://instagram.com/tu_cuenta"

# --- Acceso al panel de administración (/admin) ---
ADMIN_USUARIO="admin@example.com"
ADMIN_PASSWORD="cambia-esta-contrasena"

# --- Opcionales ---
GOOGLE_MAPS_API_KEY=""
SECRET_KEY="cambia-esta-clave-secreta-por-una-larga-y-aleatoria"

# ----------------------------------------------------------------------------
# SOLO para despliegue en Docker / Easypanel (en local NO las descomentes:
# el sitio usa por defecto la carpeta del proyecto).
# ----------------------------------------------------------------------------
# DATABASE="/app/data/angelica.db"
# MEDIA_DIR="/app/media"
# MAX_CONTENT_LENGTH="5242880"
